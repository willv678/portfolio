---
import Base from '../layouts/Base.astro';

// One line per entry. Keep `what` to a single plain sentence; the PDF has the detail.
const timeline = [
  { when: 'Jan 2027', role: 'Member of Technical Staff Intern', org: 'Abridge', where: 'San Francisco',
    what: 'Incoming.', now: true },
  { when: 'Jun – Aug 2026', role: 'Software Engineering Intern', org: 'Roblox', where: 'San Mateo',
    what: 'Built an LLM agent that writes owner-reviewed behavior catalogs for services; it ran on 60+ services and owners merged its catalogs into 40+ repos.' },
  { when: '2025 – now', role: 'Undergraduate AV Research Lead', org: 'Mobility Systems Control Lab, UGA', where: 'Athens',
    what: 'First author on SimGate: an LLM agent that runs self-driving stress tests while deterministic code checks every action.', href: '/simgate/' },
  { when: 'May 2025 – Jan 2026', role: 'Software Engineering Intern', org: 'Leidos', where: 'Atlanta',
    what: "Ported the CARMA–CARLA bridge to ROS 2 so USDOT's open-source driving stack co-simulates directly with CARLA." },
  { when: 'Dec 2023 – Mar 2025', role: 'Co-founder', org: 'Paragon Policy Fellowship', where: '',
    what: 'Nonprofit pairing students with state and local governments on tech policy. Built the platform, pitched city and state officials, helped raise $100k+.' },
  { when: '2022', role: 'Won the Congressional App Challenge', org: 'GA-05', where: '',
    what: 'TechDetect, a face-recognition attendance app built solo.', href: '/techdetect/' },
  { when: 'Jun – Jul 2022', role: 'STEM@GTRI Intern', org: 'Georgia Tech Research Institute', where: 'Atlanta',
    what: 'Where TechDetect started.' },
  { when: '~2017', role: 'Pokémon Jasper', org: 'first project', where: '',
    what: 'A Pokémon fangame made at twelve.', href: '/jasper/' },
];
---
<Base title="Experience" description="Where Will Varner has worked, researched and built.">
  <main class="page">
    <h1>Experience</h1>
    <p class="intro">
      I've been building things since I was twelve, starting with a Pokémon fangame. These days it's systems that find where AI breaks: self-driving models in simulation, LLM agents at work. I'm finishing a CS degree at the University of Georgia.
    </p>

    <dl class="facts">
      <div><dt class="mono">school</dt><dd>B.S. Computer Science, University of Georgia · 2027 · Presidential Scholar</dd></div>
      <div><dt class="mono">paper</dt><dd><strong>SimGate</strong>: reliable agentic stress testing of end-to-end driving policies. First author, submitted to IEEE IV 2027.</dd></div>
    </dl>

    <ol class="tl">
      {timeline.map((t) => (
        <li class:list={{ now: t.now }}>
          <span class="when mono">{t.when}</span>
          <div class="body">
            <h2>{t.href ? <a href={t.href} data-blip="880">{t.role}</a> : t.role}<span class="org">, {t.org}</span></h2>
            <p>{t.what}</p>
          </div>
        </li>
      ))}
    </ol>

    <p class="pdf mono"><a href="/CSResume.pdf" target="_blank" rel="noopener" data-blip="900">full resume (pdf) ↗</a></p>
  </main>
</Base>

<style>
  .page { width: min(760px, 100% - 2 * var(--gutter)); margin: 24px auto 80px; }
  h1 { font-family: var(--serif); font-weight: 500; font-size: clamp(34px, 5vw, 48px); letter-spacing: -.015em; }
  .intro { color: var(--muted); font-size: 17px; margin-top: 14px; max-width: 58ch; }
  .facts { margin: 32px 0 8px; display: grid; gap: 10px; padding: 18px 20px; background: var(--panel); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow); }
  .facts div { display: grid; grid-template-columns: 64px 1fr; gap: 12px; align-items: baseline; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  strong { font-weight: 500; }

  .tl { list-style: none; padding: 0; margin-top: 40px; position: relative; }
  .tl::before { content: ""; position: absolute; left: 180px; top: 8px; bottom: 8px; width: 1px; background: var(--line); }
  .tl li { display: grid; grid-template-columns: 180px 1fr; gap: 0 28px; padding: 10px 0 18px; position: relative; }
  .tl li::before {
    content: ""; position: absolute; left: 176px; top: 17px; width: 9px; height: 9px; border-radius: 50%;
    background: var(--bg); border: 1.5px solid var(--muted);
  }
  .tl li.now::before { background: var(--sel); border-color: var(--sel); box-shadow: 0 0 0 4px color-mix(in srgb, var(--sel) 20%, transparent); }
  .when { color: var(--muted); padding-top: 4px; white-space: nowrap; text-align: right; padding-right: 28px; }
  .tl h2 { font-size: 16px; font-weight: 500; line-height: 1.45; }
  .tl h2 a { text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
  .tl h2 a:hover { text-decoration-color: var(--ink); }
  .org { font-weight: 400; color: var(--muted); }
  .tl p { color: var(--muted); margin-top: 2px; max-width: 60ch; }
  .pdf { margin-top: 28px; }
  .pdf a { color: var(--muted); }
  .pdf a:hover { color: var(--ink); }

  @media (max-width: 640px) {
    .tl::before { left: 4px; }
    .tl li { grid-template-columns: 1fr; padding-left: 24px; }
    .tl li::before { left: 0; top: 15px; }
    .when { text-align: left; padding: 0; }
  }
</style>
