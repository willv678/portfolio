---
// One page per project, at the root: willvarner.me/warppoint
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import Buttons from '../components/Buttons.astro';
import PrevNext from '../components/PrevNext.astro';
import Figure from '../components/Figure.astro';
import YouTube from '../components/YouTube.astro';
import Note from '../components/Note.astro';
import { render } from 'astro:content';
import { projects, iconSvg } from '../lib';
import '../styles/prose.css';

export async function getStaticPaths() {
  const all = await projects();
  // Projects wrap around: → on the last one goes to the first.
  const at = (i: number) => all[(i + all.length) % all.length];
  return all.map((p, i) => ({ params: { slug: p.id }, props: { p, prev: at(i - 1), next: at(i + 1) } }));
}
const { p, prev, next } = Astro.props;
const d = p.data;
const { Content } = await render(p);
const side = (x: typeof p) => x.id === p.id ? undefined : {
  href: `/${x.id}/`, title: x.data.title, color: x.data.color, icon: iconSvg(x.data.icon, x.data.glyph),
};
const prevSide = side(prev), nextSide = side(next);
---
<Base title={d.title} description={d.blurb} accent={d.color} prev={prevSide?.href} next={nextSide?.href}>
  <main class="page">
    <Banner bg={d.bg} icon={iconSvg(d.icon, d.glyph)} vt={`vt-${p.id}`} scene={d.scene} />

    <div class="col">
      <header class="head">
        <span class="mono status">{d.status}</span>
        <h1>{d.title}</h1>
        <p class="lede">{d.blurb}</p>
        {(d.tags.length > 0 || d.links.length > 0) && (
          <div class="meta">
            <Buttons links={d.links} />
            {d.tags.length > 0 && <div class="tags mono">{d.tags.map((t) => <span>{t}</span>)}</div>}
          </div>
        )}
      </header>

      <article class="prose">
        <Content components={{ Figure, YouTube, Note }} />
      </article>

      <PrevNext prev={prevSide} next={nextSide} />
    </div>
  </main>
</Base>

<style>
  .page { width: min(980px, 100% - 2 * var(--gutter)); margin: 8px auto 72px; }
  /* Everything under the banner shares one column and one left edge. */
  .col { width: min(680px, 100%); margin: 0 auto; }
  .head { margin: 56px 0 0; padding-bottom: 36px; border-bottom: 1px solid var(--line); }
  .status { color: var(--muted); }
  h1 { font-family: var(--serif); font-weight: 500; font-size: clamp(36px, 5vw, 54px); letter-spacing: -.015em; line-height: 1.08; margin-top: 8px; }
  .lede { color: var(--muted); font-size: 18px; line-height: 1.6; margin-top: 14px; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; margin-top: 22px; }
  .tags { display: flex; gap: 6px; }
  .tags span { border: 1px solid var(--line); border-radius: 99px; padding: 1px 9px; color: var(--muted); }
  article { margin-top: 44px; }
  /* Figures and videos get a little wider than the text. */
  article :global(.fig), article :global(.yt) { margin-left: clamp(-90px, -7vw, 0px); margin-right: clamp(-90px, -7vw, 0px); }
  @media (max-width: 720px) {
    .head { margin-top: 32px; }
    article :global(.fig), article :global(.yt) { margin-left: 0; margin-right: 0; }
  }
</style>
