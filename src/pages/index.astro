---
import Base from '../layouts/Base.astro';
import Experience from '../components/Experience.astro';
import { projects, posts, iconSvg } from '../lib';

// The shelf: everything pinned (projects and posts), then empty slots up to a
// full row of 6, so new work has an obvious place to land.
const items = [
  ...(await projects()).filter((p) => p.data.pinned).map((p) => ({
    kind: 'project' as const, href: `/${p.id}/`, vt: `vt-${p.id}`, ...p.data,
    icon: iconSvg(p.data.icon, p.data.glyph),
  })),
  ...(await posts()).filter((p) => p.data.pinned).map((p) => ({
    kind: 'post' as const, href: `/writing/${p.id}/`, vt: `vt-w-${p.id}`, ...p.data,
    color: 'var(--ink)', bg: 'var(--bg)', icon: '', scene: undefined, banner: undefined,
  })),
].sort((a, b) => a.order - b.order);
const empties = Math.max(0, Math.ceil((items.length + 1) / 6) * 6 - items.length);
---
<Base home>
  <!-- Don't paint until the shelf exists, so the banner → tile morph always has a target. -->
  <link slot="head" rel="expect" href="#shelf" blocking="render" />
  <section class="first" id="top">
  <button class="say mono" id="me-say" hidden>click the button up there ↗ to make your own character</button>
  <main class="console">
    <section class="stage">
      <div class="screen" id="screen">
        <div class="view me" id="home">
          <button class="me-fig" id="me-fig" aria-label="Customize your character" data-blip="760"></button>
          <img src="/me.jpg" alt="Will Varner" width="480" height="480" />
          <div>
            <h1>Will Varner</h1>
            <p>I like finding where things break, and then fixing them. At work, that's meant AI agents at Roblox and stress-testing self-driving models at UGA, and in January, clinical AI at Abridge. For fun it's games: how they run, how they break, and tools that make them do things they weren't made for.</p>
            <div class="links mono">
              <a href="https://github.com/willv678">github</a>
              <a href="https://linkedin.com/in/will-varner">linkedin</a>
              <a href="mailto:willv678@gmail.com">email</a>
            </div>
          </div>
        </div>
        <button class="x" id="proj-x" aria-label="Back to about" hidden>×</button>
        <a class="view proj" id="proj" hidden tabindex="-1">
          <div class="banner" id="pbanner"></div>
          <div class="info">
            <span class="status mono" id="pstatus"></span>
            <h2 id="ptitle"></h2>
            <p id="pblurb"></p>
            <div class="foot-row">
              <div class="tags mono" id="ptags"></div>
              <span class="open mono" aria-hidden="true">open <kbd>↵</kbd></span>
            </div>
          </div>
        </a>
      </div>
    </section>

    <section class="shelf-wrap">
      <ul class="shelf" id="shelf" aria-label="Projects and writing">
        {items.map((it, i) => (
          <li>
            <a
              class:list={['tile', it.kind === 'post' && 'post']}
              href={it.href}
              data-i={i}
              style={`--c:${it.color};--k:${i};view-transition-name:${it.vt}`}
              aria-label={it.title}
            >
              {it.kind === 'post'
                ? <span class="lines" aria-hidden="true"><i /><i /><i /><i /></span>
                : <span class="ico" set:html={it.icon} />}
              <span class="label mono" aria-hidden="true">{it.title}</span>
            </a>
          </li>
        ))}
        {Array.from({ length: empties }).map(() => <li><span class="tile empty" title="coming soon" /></li>)}
      </ul>
    </section>
  </main>

  <footer class="foot mono">
    <span class="hint">← → to browse · enter to open</span>
    <a class="cue" href="#experience" data-blip="620">experience <span aria-hidden="true">↓</span></a>
    <span class="loc">ATL → SF</span>
  </footer>
  </section>

  <Experience />

  <script is:inline type="application/json" id="shelf-data" set:html={JSON.stringify(items.map(({ title, blurb, status, tags, bg, color, kind, href, scene, banner }) => ({ title, blurb, status, tags, bg, color, kind, href, scene, banner })))} />

  <script>
    import { blip, openSound } from '../scripts/sound';
    import { getScene, preloadScenes } from '../scripts/scenes';
    import { svg as avatarSvg, load as loadAvatar, DEFAULT as DEFAULT_AVATAR, isWill } from '../scripts/avatar';
    import { speak } from '../scripts/voice';
    import { STATUS } from '../data/status';
    import { shown } from '../scripts/shown';
    await shown;   // if this page was rendered ahead of time, start once it's actually shown

    type Item = { title: string; blurb: string; status: string; tags: string[]; bg: string; color: string; kind: 'project' | 'post'; href: string; scene?: string; banner?: string };
    const P: Item[] = JSON.parse(document.getElementById('shelf-data')!.textContent!);
    const tiles = [...document.querySelectorAll<HTMLAnchorElement>('.tile[data-i]')];
    const $ = (id: string) => document.getElementById(id)!;
    const home = $('home'), proj = $('proj') as HTMLAnchorElement;
    let cur = -1;
    // A selected project with a 3D scene plays it in the panel. Scenes are
    // built once (preloaded while idle on desktop) and just paused when you
    // move on, so re-selecting is instant and idle costs nothing.
    preloadScenes(['me', ...new Set(P.map((p) => p.scene).filter((s): s is string => !!s))]);

    // Your avatar in the about panel, in 3D. Nothing shows until it's ready
    // (the flat drawing is only a fallback for browsers without WebGL). It
    // walks in from the right on a fresh arrival, not when you come back from
    // a project. It pauses while a project is showing. Click → editor.
    const meFig = $('me-fig');
    let flat = false;
    const drawFlat = () => { if (flat) meFig.innerHTML = avatarSvg(loadAvatar() ?? DEFAULT_AVATAR); };
    addEventListener('avatar-change', drawFlat);
    let me: { attach(el: HTMLElement, o?: { sfx?: 'always' | 'hover' }): void; detach(): void } | null = null;
    const showMe = (on: boolean) => {
      if (on) getScene('me').then((s) => {
        if (!s) { flat = true; drawFlat(); return; }
        if (cur >= 0) return;
        // walk in on a fresh arrival (typed in, a link from another site, a
        // reload), but not when you come back from one of this site's pages
        const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
        let fromHere = false; try { fromHere = new URL(document.referrer).origin === location.origin; } catch {}
        const first = nav?.type === 'reload' || !fromHere;
        me = s; meFig.innerHTML = ''; s.attach(meFig);
        if (first && meFig.offsetParent) dispatchEvent(new Event('avatar-walk-in'));
      });
      else me?.detach();
    };
    showMe(true);
    meFig.addEventListener('click', () => document.getElementById('who')?.click());
    $('me-say').addEventListener('click', () => document.getElementById('who')?.click());
    // Place the bubble just above your avatar's head, growing out to the right
    // (past the panel's edge, toward the top-right button).
    const placeSay = () => {
      const say = $('me-say'), f = meFig.getBoundingClientRect(), box = $('top').getBoundingClientRect();
      // grow to the right, but never past the window's edge
      say.style.left = `${Math.min(f.left - box.left + f.width * 0.5, box.width - 250)}px`;
      say.style.top = `${f.top - box.top + f.height * 0.06}px`;
    };
    addEventListener('resize', () => { if (!$('me-say').hidden) (meFig.offsetParent ? placeSay() : quiet()); });

    // ---------- your avatar talks ----------
    // Lines type out in the bubble with a babbling synthesized voice pitched for
    // the current avatar. First visits: "make your own character" (while it
    // points at the button). Then a status line every ~12s: first person when
    // the avatar is Will's own, third person when it's a visitor's character.
    const say = $('me-say');
    let hush: (() => void) | null = null, hideT = 0;
    function sayLine(text: string, ms: number, pointing = false) {
      hush?.(); clearTimeout(hideT);
      placeSay();
      say.textContent = ''; say.hidden = false;
      if (pointing) dispatchEvent(new Event('avatar-point'));
      dispatchEvent(new CustomEvent('avatar-talk', { detail: true }));
      hush = speak(text, loadAvatar() ?? DEFAULT_AVATAR, (shown) => (say.textContent = shown),
        () => dispatchEvent(new CustomEvent('avatar-talk', { detail: false })));
      hideT = window.setTimeout(quiet, ms);
    }
    function quiet() {
      hush?.(); hush = null; clearTimeout(hideT);
      say.hidden = true;
      dispatchEvent(new Event('avatar-point-end'));
      dispatchEvent(new CustomEvent('avatar-talk', { detail: false }));
    }
    addEventListener('avatar-hush', quiet);

    // What it says, in order: every time the page loads, the first line is
    // about the character itself (still Will's default: point at the editor
    // button, which rings; already made one: "click me"). Then a status line
    // every ~12s, never the same one twice in a row.
    const wide = matchMedia('(min-width: 721px)');    // phones: no speech bubble (no room), so it stays quiet
    let lastLine = -1, intro = true, nextAt = performance.now() + 2600;   // after the walk-in
    setInterval(() => {
      const now = performance.now();
      const free = cur < 0 && !document.hidden && !document.documentElement.classList.contains('editing')
        && meFig.offsetParent && wide.matches && scrollY < innerHeight * 0.5 && say.hidden;
      if (!free || now < nextAt) return;
      if (intro) {
        intro = false;
        if (isWill(loadAvatar())) { sayLine('click the button up there ↗ to make your own character', 8000, true); dispatchEvent(new Event('avatar-ring')); }
        else sayLine('click me to change how I look', 5000);
        nextAt = now + 14000;
        return;
      }
      let k = Math.floor(Math.random() * STATUS.length);
      if (k === lastLine) k = (k + 1) % STATUS.length;
      lastLine = k;
      const line = isWill(loadAvatar()) ? STATUS[k].me : STATUS[k].them;
      sayLine(line, Math.max(4500, line.length * 70 + 2200));
      nextAt = now + 12000;
    }, 500);
    let playing: { detach(): void } | null = null, token = 0;
    const dropScene = () => { token++; playing?.detach(); playing = null; };

    // On phones the about view and a project preview are different heights,
    // so switching between them animates the panel's height (and fades the
    // new content in) instead of snapping.
    const screenEl = $('screen');
    const narrow = matchMedia('(max-width: 720px)'), still = matchMedia('(prefers-reduced-motion: reduce)');
    function select(i: number) {
      if (i === cur) return;
      const animate = narrow.matches && !still.matches;
      const from = animate ? screenEl.getBoundingClientRect().height : 0;
      swap(i);
      if (!animate) return;
      const to = screenEl.getBoundingClientRect().height;
      const ease = 'cubic-bezier(.3,.9,.3,1)';
      if (Math.abs(to - from) > 1) screenEl.animate([{ height: `${from}px` }, { height: `${to}px` }], { duration: 320, easing: ease });
      (i < 0 ? home : proj).animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 260, easing: ease });
    }
    function swap(i: number) {
      cur = i;
      dropScene();
      tiles.forEach((t, j) => t.classList.toggle('on', j === i));
      $('proj-x').hidden = i < 0;
      showMe(i < 0);
      if (i >= 0) dispatchEvent(new Event('avatar-hush'));
      if (i < 0) { home.hidden = false; proj.hidden = true; return; }
      const p = P[i], tile = tiles[i];
      blip(760 + i * 60);
      const banner = $('pbanner');
      banner.style.color = p.color;
      banner.style.background = p.banner ? `center / cover no-repeat url("${p.banner}"), ${p.bg}` : p.bg;
      banner.innerHTML = p.kind === 'post'
        ? `<div class="post-title"></div>`
        : p.banner ? '' : `<div class="banner-ico">${tile.querySelector('.ico')!.innerHTML
            .replace(/id="([^"]+)"/g, 'id="$1-panel"')
            .replace(/url\(#([^)]+)\)/g, 'url(#$1-panel)')}</div>`;
      if (p.kind === 'post') banner.firstElementChild!.textContent = p.title;
      if (p.scene) {
        const mine = ++token;
        getScene(p.scene).then((s) => { if (s && mine === token) { s.attach(banner, { sfx: 'always' }); playing = s; } });
      }
      $('ptitle').textContent = p.title;
      $('pblurb').textContent = p.blurb;
      $('pstatus').textContent = p.status;
      $('ptags').replaceChildren(...p.tags.map((t) => Object.assign(document.createElement('span'), { className: 'tag', textContent: t })));
      proj.href = p.href;
      home.hidden = true; proj.hidden = false;
    }

    // Mouse: hovering a tile selects it. The selection holds while the pointer
    // is on a tile or inside the top panel (so you can read or click it). Only
    // empty space goes back to the about view, after a short grace period so
    // the trip from a tile up to the panel doesn't drop the selection.
    let leave: number | undefined;
    const later = () => { clearTimeout(leave); leave = window.setTimeout(() => select(-1), 250); };
    // Keyboard mode (see global.css): arrows hide the cursor and pause hover
    // until the mouse actually moves. Tiles lifting/dropping under a resting
    // cursor fire fake hover events, which used to steal the selection back.
    const root = document.documentElement;
    let mx = -1, my = -1;
    addEventListener('pointermove', (e) => {
      if (e.clientX === mx && e.clientY === my) return;
      mx = e.clientX; my = e.clientY;
      root.classList.remove('kbd');
    });
    addEventListener('pointerover', (e) => {
      if (e.pointerType === 'touch') return;          // phones: taps are handled below
      if (root.classList.contains('kbd')) return;
      const t = (e.target as Element).closest<HTMLElement>('.tile[data-i]');
      if (t) { clearTimeout(leave); select(Number(t.dataset.i)); return; }
      if ((e.target as Element).closest('#screen')) { clearTimeout(leave); return; }
      if (cur >= 0) later();
    });
    // (a finger lifting off the screen also "leaves" the page; that isn't a mouse wandering off)
    root.addEventListener('pointerleave', (e) => { if (e.pointerType !== 'touch' && !root.classList.contains('kbd')) later(); });
    let lastTouch = 0;
    addEventListener('pointerdown', (e) => { if (e.pointerType === 'touch') lastTouch = performance.now(); }, { capture: true });

    // Keyboard: arrows browse like a console menu, Enter opens, Esc backs out.
    addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey || !tiles.length) return;
      if (scrollY > innerHeight * 0.5) return;                   // the shelf is off screen
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        root.classList.add('kbd'); clearTimeout(leave);
        const d = e.key === 'ArrowRight' ? 1 : -1;
        select(cur < 0 ? 0 : (cur + d + tiles.length) % tiles.length);
        tiles[cur].focus({ preventScroll: true });
        e.preventDefault();
      } else if (e.key === 'Enter' && cur >= 0 && document.activeElement === document.body) {
        tiles[cur].click();
      } else if (e.key === 'Escape') {
        select(-1); (document.activeElement as HTMLElement | null)?.blur();
      }
    });
    // Say hello once: a little hop runs across the apps, so it's obvious they're there to be picked.
    setTimeout(() => { if (cur < 0) tiles.forEach((t) => t.classList.add('wave')); setTimeout(() => tiles.forEach((t) => t.classList.remove('wave')), 1400); }, 900);

    // Attract mode: when nothing is happening, one app at a time plays its
    // little animation with a tiny hop, cycling along the shelf. It pauses while
    // you hover or browse, and never runs for reduced-motion users.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let idleAt = performance.now(), next = 0;
      ['pointermove', 'keydown', 'scroll'].forEach((ev) => addEventListener(ev, () => (idleAt = performance.now()), { passive: true }));
      setInterval(() => {
        if (cur >= 0 || document.hidden || scrollY > innerHeight * 0.5 || performance.now() - idleAt < 3500 || !tiles.length) return;
        const t = tiles[next++ % tiles.length];
        t.classList.add('peek');
        setTimeout(() => t.classList.remove('peek'), 1700);
      }, 2600);
    }

    // Tabbing onto a tile selects it too.
    tiles.forEach((t, i) => t.addEventListener('focus', () => { if (performance.now() - lastTouch > 600) select(i); }));
    // Touch screens (no hover): the first tap on an app shows its panel, like
    // highlighting an icon on a 3DS; tapping it again (or "open") goes to the page.
    const touch = matchMedia('(hover: none)').matches;
    const x = $('proj-x');
    tiles.forEach((t, i) => t.addEventListener('click', (e) => {
      if (!touch || cur === i) return;
      e.preventDefault();
      select(i);
      $('screen').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }));
    x.addEventListener('click', () => select(-1));
    if (touch) {
      // tapping anywhere else goes back to the about view…
      document.addEventListener('click', (e) => { if (cur >= 0 && !(e.target as Element).closest('.tile, #screen')) select(-1); });
      // …and so does leaving it alone for 15 seconds
      let idleT = 0;
      const arm = () => { clearTimeout(idleT); if (cur >= 0) idleT = window.setTimeout(() => select(-1), 15000); };
      tiles.forEach((t) => t.addEventListener('click', () => setTimeout(arm)));
      ['touchstart', 'scroll'].forEach((ev) => addEventListener(ev, arm, { passive: true }));
    }
    document.addEventListener('click', (e) => { if ((e.target as Element).closest('.tile, #proj') && (!touch || cur >= 0)) openSound(); });

    // Two "screens". Any small scroll down from the top glides to the
    // timeline; a small scroll up from the start of the timeline glides back.
    // Everywhere else scrolls normally. While a glide is running (and while a
    // trackpad's momentum is still coming in) extra wheel events are eaten, so
    // you land exactly on the first entry.
    const xp = document.getElementById('experience')!;
    let lockUntil = 0, lockMax = 0;
    const glide = (y: number) => { const n = performance.now(); lockUntil = n + 650; lockMax = n + 1000; scrollTo({ top: y, behavior: 'smooth' }); };
    const inTop = () => scrollY < xp.offsetTop - 4;
    const atBoundary = () => scrollY > 4 && scrollY <= xp.offsetTop + 4;
    function flip(dir: number) {
      if (dir > 0 && inTop()) { glide(xp.offsetTop); return true; }
      if (dir < 0 && atBoundary()) { glide(0); return true; }
      return false;
    }
    addEventListener('wheel', (e) => {
      const now = performance.now();
      if (now < lockUntil) { lockUntil = Math.min(lockMax, Math.max(lockUntil, now + 120)); e.preventDefault(); return; }
      if (e.ctrlKey || Math.abs(e.deltaY) < 1.5 || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
      if (flip(Math.sign(e.deltaY))) e.preventDefault();
    }, { passive: false });
    addEventListener('keydown', (e) => {
      if ((e.target as Element).closest('input, textarea') || e.metaKey || e.ctrlKey || e.altKey) return;
      const down = ['ArrowDown', 'PageDown', ' '].includes(e.key) && !e.shiftKey;
      const up = ['ArrowUp', 'PageUp'].includes(e.key) || (e.key === ' ' && e.shiftKey);
      if ((down && flip(1)) || (up && flip(-1))) e.preventDefault();
    });
    let ty = 0, decided = false;
    addEventListener('touchstart', (e) => { ty = e.touches[0].clientY; decided = false; }, { passive: true });
    addEventListener('touchmove', (e) => {
      if (decided) return;
      const dy = ty - e.touches[0].clientY;
      if (Math.abs(dy) < 14) return;
      decided = true;
      if (flip(Math.sign(dy))) e.preventDefault();
    }, { passive: false });
  </script>
</Base>

<style>
  :global(html:has(body[data-home])) { scroll-behavior: smooth; }
  .first { position: relative; min-height: calc(100svh - 62px); display: grid; grid-template-rows: 1fr auto; }
  .console { display: flex; flex-direction: column; justify-content: center; gap: clamp(24px, 4vh, 44px); min-width: 0; }

  /* ---------- top screen ---------- */
  .stage { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; padding: 0 var(--gutter); }
  .screen {
    width: min(980px, 100%, calc((100vh - 300px) * 16 / 7)); aspect-ratio: 16 / 7;
    background: var(--panel); border: 1px solid var(--line); border-radius: 18px;
    box-shadow: var(--shadow); position: relative;
    /* 16:7 is the minimum: the views sit in one grid cell, in flow, so if the
       text needs more room (a narrow or short window) the panel grows instead
       of cutting it off. (clip, not hidden: hidden would cancel that growth.) */
    overflow: clip; display: grid; container-type: inline-size;
  }
  .view {
    position: relative; grid-area: 1 / 1; min-width: 0; padding: clamp(20px, 4vw, 44px);
    display: flex; gap: 36px; align-items: center;
    transition: opacity .28s ease, transform .28s ease;
  }
  .view[hidden] { display: flex; opacity: 0; transform: translateY(6px); pointer-events: none; visibility: hidden; transition: opacity .28s, transform .28s, visibility 0s .28s; }
  /* your character: last in the row, as tall as the panel's content area */
  .me-fig {
    order: 3; align-self: stretch; flex: none; margin-left: auto; position: relative;
    /* reaches the panel's right edge (past the padding), so the walk-in comes from outside the panel */
    --pad: clamp(20px, 4vw, 44px); width: calc(clamp(140px, 20%, 220px) + var(--pad)); margin-right: calc(-1 * var(--pad)); padding-right: 0;
    background: none; border: 0; padding: 0; cursor: pointer; display: grid; place-items: center;
  }
  .me-fig :global(svg) { width: 72%; height: auto; transition: transform .2s cubic-bezier(.3,1.6,.5,1); }
  .me-fig:hover :global(svg) { transform: translateY(-4px) rotate(-3deg); }
  .me-fig :global(.scene-canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .me-fig:global(.hop) { animation: me-hop .6s cubic-bezier(.3,.7,.4,1) 2; }
  @keyframes me-hop { 40% { transform: translateY(-10px); } 70% { transform: translateY(2px); } }
  /* the avatar's speech bubble (first visits, while you still have the default avatar) */
  .say {
    position: absolute; z-index: 5; cursor: pointer; transform-origin: 0 100%; translate: 0 -100%; width: 230px; line-height: 1.45;
    background: var(--panel); color: var(--ink); border: 1.5px solid var(--ink); border-radius: 14px;
    padding: 8px 13px; font-size: 12px; box-shadow: var(--shadow);
    animation: say-in .35s cubic-bezier(.3,1.5,.5,1), say-bob 2s ease-in-out .35s infinite;
  }
  .say::after { /* the tail, at the bottom-left, pointing down at the character */
    content: ""; position: absolute; left: 14px; bottom: -8px; width: 12px; height: 12px; background: var(--panel);
    border-right: 1.5px solid var(--ink); border-bottom: 1.5px solid var(--ink); transform: rotate(45deg);
  }
  .say[hidden] { display: none; }
  .say:hover { background: var(--bg); }
  @keyframes say-in { from { transform: translateY(6px) scale(.85); opacity: 0; } }
  @keyframes say-bob { 50% { transform: translateY(-3px); } }
  .me > div { flex: 1 1 auto; min-width: 0; max-width: 46ch; }
  .me img { width: clamp(128px, 20vw, 220px); height: auto; aspect-ratio: 1; border-radius: 14px; flex: none; object-fit: cover; }
  h1, h2 { font-family: var(--serif); font-weight: 500; letter-spacing: -.01em; }
  h1 { font-size: clamp(28px, 4vw, 40px); line-height: 1.1; }
  .me p { color: var(--muted); max-width: 52ch; margin-top: 10px; }
  .links { margin-top: 16px; display: flex; gap: 16px; }
  .links a { text-decoration: none; border-bottom: 1px solid var(--line); }
  .links a:hover { border-color: var(--ink); }

  .proj { padding: 0; align-items: stretch; gap: 0; color: inherit; text-decoration: none; cursor: pointer; }
  .proj .banner { flex: 1.25; display: grid; place-items: center; position: relative; overflow: hidden; }
  .proj .banner :global(.scene-canvas) { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity .5s ease; }
  .proj .banner:global(.scene-on) :global(.scene-canvas) { opacity: 1; }
  .proj .banner :global(.banner-ico) { transition: opacity .4s; }
  .proj .banner:global(.scene-on) :global(.banner-ico) { opacity: 0; }
  .proj :global(.banner-ico) { width: 26%; }
