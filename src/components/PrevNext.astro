---
// Bottom of a project page or post: ← previous, esc home, next →.
// The same targets are bound to the arrow keys (see Base.astro).
interface Side { href: string; title: string; color?: string; icon?: string }
interface Props { prev?: Side; next?: Side }
const { prev, next } = Astro.props;
---
<!-- On wide screens: the neighbors also sit at the screen edges, so ← / → is discoverable. -->
{prev && (
  <a class="edge l" href={prev.href} data-blip="900" aria-label={`Previous: ${prev.title}`} style={prev.color && `--c:${prev.color}`}>
    <span class="key" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg></span>
    <span class="mono name">{prev.title}</span>
  </a>
)}
{next && (
  <a class="edge r" href={next.href} data-blip="980" aria-label={`Next: ${next.title}`} style={next.color && `--c:${next.color}`}>
    <span class="key" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M6 3.5 10.5 8 6 12.5" /></svg></span>
    <span class="mono name">{next.title}</span>
  </a>
)}
<nav class="pn" aria-label="More">
  {prev ? (
    <a class="side nav-tile l" href={prev.href} data-blip="900">
      {prev.icon && <span class="tile" style={`color:${prev.color}`} set:html={prev.icon} />}
      <span><span class="mono lbl"><kbd>←</kbd> previous</span><span class="t">{prev.title}</span></span>
    </a>
  ) : <span />}
  <a class="home mono" href="/" data-blip="700"><kbd>esc</kbd> home</a>
  {next ? (
    <a class="side nav-tile r" href={next.href} data-blip="980">
      <span><span class="mono lbl">next <kbd>→</kbd></span><span class="t">{next.title}</span></span>
      {next.icon && <span class="tile" style={`color:${next.color}`} set:html={next.icon} />}
    </a>
  ) : <span />}
</nav>
<script>
  // The arrow keys use a slide transition; make clicking these do the same.
  document.querySelectorAll<HTMLAnchorElement>('.pn .side, .edge').forEach((a) =>
    a.addEventListener('click', () => { try { sessionStorage.setItem('nav-dir', a.classList.contains('l') ? 'prev' : 'next'); } catch {} }));
</script>
<style>
  .pn { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; margin-top: 80px; padding-top: 28px; border-top: 1px solid var(--line); }
  .home { color: var(--muted); text-decoration: none; display: flex; gap: 8px; align-items: center; }
  .home:hover { color: var(--ink); }
  kbd { font: inherit; font-size: 11px; border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 5px; padding: 0 5px; background: var(--panel); }
  .side { display: flex; align-items: center; gap: 14px; text-decoration: none; }
  .side > span:not(.tile) { display: grid; gap: 2px; }
  .r { justify-self: end; text-align: right; }
  .lbl { color: var(--muted); }
  .t { font-family: var(--serif); font-size: 19px; line-height: 1.2; }
  .tile {
    flex: none; width: 52px; height: 52px; border-radius: 14px; background: var(--panel); border: 1px solid var(--line);
    box-shadow: var(--shadow); display: grid; place-items: center; padding: 12px;
    transition: transform .18s cubic-bezier(.3,1.6,.5,1);
  }
  .tile :global(svg) { width: 100%; height: auto; }
  .side:hover .tile { transform: translateY(-3px) scale(1.05); }
  /* the edge arrows: a key cap that nudges outward now and then, the title under it */
  .edge {
    position: fixed; top: calc(50% - 20px); z-index: 20; display: none; justify-items: center; align-content: start; gap: 10px;
    width: 120px; text-decoration: none; color: var(--muted);
  }
  .edge.l { left: max(8px, calc((100vw - 980px) / 4 - 60px)); }
  .edge.r { right: max(8px, calc((100vw - 980px) / 4 - 60px)); }
  .edge.l { view-transition-name: edge-l; }
  .edge.r { view-transition-name: edge-r; }
  .key {
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px;
    background: var(--panel); border: 1px solid var(--line); border-bottom-width: 3px; box-shadow: var(--shadow);
    transition: transform .18s cubic-bezier(.3,1.6,.5,1), border-color .18s;
  }
  .key svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .l .key svg { animation: nudge-l 3.2s ease-in-out infinite; }
  .r .key svg { animation: nudge-r 3.2s ease-in-out infinite; }
  .name { font-size: 11px; text-align: center; line-height: 1.35; opacity: .75; transition: opacity .18s, color .18s; }
  .edge:hover { color: var(--ink); }
  .edge:hover .key, .edge:focus-visible .key { transform: translateY(-2px); border-color: var(--c, var(--accent)); color: var(--c, var(--accent)); }
  .edge:active .key { transform: translateY(1px); border-bottom-width: 1px; }
  .edge:hover .name { opacity: 1; }
  @keyframes nudge-l { 0%, 70%, 100% { transform: none } 80% { transform: translateX(-3px) } 90% { transform: translateX(1px) } }
  @keyframes nudge-r { 0%, 70%, 100% { transform: none } 80% { transform: translateX(3px) } 90% { transform: translateX(-1px) } }
  @media (min-width: 1240px) and (hover: hover) { .edge { display: grid; } }
  @media (prefers-reduced-motion: reduce) { .key svg { animation: none !important; } }
  @media (max-width: 640px) {
    .pn { grid-template-columns: 1fr 1fr; }
    .home { grid-column: 1 / -1; grid-row: 2; justify-self: center; }
    .tile { display: none; }
  }
</style>
