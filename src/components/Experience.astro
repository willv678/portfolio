---
// The timeline, second "screen" of the home page.
//
// Desktop: the timeline pins in place while you scroll, and the scroll moves
// the *active* entry instead of the page: each entry gets an equal slice of
// scroll, entries appear one by one, the line draws down to the active dot,
// and the 3D viewer on the right (which never moves) shows the active one.
// Once past the last entry the page carries on to the "earlier" list.
// Phones: a normal list that reveals as you scroll; no viewer.
import { experience } from '../data/experience';
const major = experience.filter((e) => !e.minor);
const minor = experience.filter((e) => e.minor);
const when = (e: (typeof experience)[number]) => (e.end ? `${e.start} – ${e.end}` : e.start);
---
<section id="experience" class="exp" style={`--n:${major.length}`} aria-labelledby="exp-h">
  <div class="pin">
    <div class="inner">
      <div class="col">
        <h2 id="exp-h">Experience</h2>
        <ol class="tl" id="tl">
          {major.map((e, i) => (
            <li class="entry" data-i={i} data-model={e.model} data-org={e.org} data-when={when(e)}>
              <span class="dot" aria-hidden="true" />
              <span class="when mono">{when(e)}</span>
              <h3>{e.href ? <a href={e.href} data-blip="880">{e.role}</a> : e.role}<span class="org">{e.org}</span></h3>
              <p>{e.what}</p>
            </li>
          ))}
        </ol>
      </div>
      <aside class="viewer" aria-hidden="true">
        <div class="box" id="xp-stage"></div>
        <div class="cap mono"><span id="xp-org"></span><span id="xp-when"></span></div>
      </aside>
    </div>
  </div>
</section>

<section class="after">
  <div class="inner-after">
    <h4 class="mono earlier">earlier</h4>
    <ul class="minor">
      {minor.map((e) => (
        <li>
          <span class="when mono">{when(e)}</span>
          <span>{e.href ? <a href={e.href} data-blip="880">{e.role}</a> : e.role}<span class="org">{e.org}</span><span class="what">{e.what}</span></span>
        </li>
      ))}
    </ul>
    <p class="end mono">
      <a href="/CSResume.pdf" target="_blank" rel="noopener" data-blip="900">full resume (pdf) ↗</a>
      <a href="#top" data-blip="700">back to top ↑</a>
    </p>
  </div>
</section>

<script>
  import { blip } from '../scripts/sound';
  import { getScene } from '../scripts/scenes';

  const sec = document.getElementById('experience')!;
  const tl = document.getElementById('tl')!;
  const entries = [...tl.querySelectorAll<HTMLElement>('.entry')];
  const dots = entries.map((e) => e.querySelector<HTMLElement>('.dot')!);
  const stage = document.getElementById('xp-stage')!;
  const org = document.getElementById('xp-org')!, when = document.getElementById('xp-when')!;
  const pinned = () => matchMedia('(min-width: 821px)').matches;
  document.documentElement.classList.add('xp-anim');   // only hide entries when JS can reveal them

  // The 3D viewer loads once the section is close to the screen.
  type Viewer = { attach(el: HTMLElement, o?: { sfx?: 'always' | 'hover' }): void; show(m: string): void };
  let viewer: Viewer | null = null, pending = '';
  new IntersectionObserver(([e], io) => {
    if (!e.isIntersecting || !pinned()) return;
    io.disconnect();
    getScene('experience').then((s) => {
      if (!s) return;
      viewer = s as unknown as Viewer;
      viewer.attach(stage, { sfx: 'always' });
      if (pending) viewer.show(pending);
    });
  }, { rootMargin: '100% 0px' }).observe(sec);

  let active = -1;
  function setActive(i: number) {
    if (i === active) return;
    active = i;
    entries.forEach((e, j) => { e.classList.toggle('on', j === i); if (j <= i) e.classList.add('in'); });
    const e = entries[i];
    org.textContent = e.dataset.org!;
    when.textContent = e.dataset.when!;
    blip(520 + i * 70, 0.04, 0.018);
    pending = e.dataset.model ?? '';
    viewer?.show(pending);
  }

  function update() {
    const tr = tl.getBoundingClientRect();
    const dotY = (i: number) => dots[i].getBoundingClientRect().top + 6 - tr.top;
    if (pinned()) {
      // progress through the pinned stretch → which entry is active
      const top = sec.offsetTop, range = sec.offsetHeight - innerHeight;
      const p = Math.min(0.9999, Math.max(0, (scrollY - top) / range));
      const f = p * entries.length, i = Math.floor(f);
      // only hide entries that are still ahead (when scrolling back up)
      entries.forEach((e, j) => e.classList.toggle('in', j <= i));
      setActive(i);
      tl.style.setProperty('--line', `${dotY(i)}px`);
    } else {
      // phones: plain list; active = nearest the middle of the screen
      const mid = innerHeight * 0.45;
      let best = 0, bestD = Infinity;
      entries.forEach((e, j) => {
        const b = e.getBoundingClientRect(), d = Math.abs(b.top + b.height / 2 - mid);
        if (b.top < innerHeight * 0.9) e.classList.add('in');
        if (d < bestD) { bestD = d; best = j; }
      });
      setActive(best);
      tl.style.setProperty('--line', `${dotY(best)}px`);
    }
  }
  addEventListener('scroll', update, { passive: true });           // cheap: a few rect reads
  addEventListener('resize', update);
  update();
</script>

<style>
  /* Desktop: the section is tall (one viewport + a slice per entry) and its
     content pins to the viewport while you scroll through it. */
  .exp { position: relative; height: calc(100svh + (var(--n) - 1) * 34svh); border-top: 1px solid var(--line); }
  .pin { position: sticky; top: 0; height: 100svh; display: grid; align-items: center; padding: 0 var(--gutter); overflow: hidden; }
  .inner { width: min(1040px, 100%); margin: 0 auto; display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 56px; align-items: center; }
  h2 { font-family: var(--serif); font-weight: 500; font-size: clamp(30px, 4.2vw, 42px); letter-spacing: -.015em; margin-bottom: clamp(16px, 3.5vh, 32px); }

  /* the line: a faint track, plus an ink line drawn down to the active dot */
  .tl { list-style: none; padding: 0 0 0 30px; position: relative; --line: 0px; }
  .tl::before, .tl::after { content: ""; position: absolute; left: 5px; top: 10px; width: 1.5px; border-radius: 1px; }
  .tl::before { bottom: 10px; background: var(--line); }
  .tl::after { height: calc(var(--line) - 10px); background: var(--ink); transition: height .45s cubic-bezier(.3,.9,.3,1); }

  .entry { position: relative; padding: 2px 0 clamp(14px, 3.2vh, 30px); }
  .dot {
    position: absolute; left: -30px; top: 7px; width: 12px; height: 12px; border-radius: 50%;
    background: var(--bg); border: 1.5px solid var(--muted); z-index: 1;
    transition: transform .25s cubic-bezier(.3,1.6,.5,1), background .2s, border-color .2s;
  }
  .when { color: var(--muted); }
  h3 { font-size: 17.5px; font-weight: 500; line-height: 1.35; margin-top: 2px; display: flex; flex-wrap: wrap; gap: 0 10px; align-items: baseline; }
  h3 a { text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
  h3 a:hover { text-decoration-color: var(--ink); }
  .org { font-weight: 400; color: var(--muted); }
  .entry p { color: var(--muted); margin-top: 3px; max-width: 58ch; }

  /* entries appear one by one; the active one is in full ink */
  :global(.xp-anim) .entry { opacity: 0; transform: translateY(12px); transition: opacity .45s ease, transform .45s cubic-bezier(.2,.8,.3,1); }
  :global(.xp-anim) .entry:global(.in) { opacity: .42; transform: none; }
  :global(.xp-anim) .entry:global(.in.on) { opacity: 1; }
  .entry:global(.on) .dot { background: var(--ink); border-color: var(--ink); transform: scale(1.25); }

  /* the viewer: pinned with the timeline, so it never drifts */
  .viewer { display: grid; gap: 12px; }
  .box {
    position: relative; aspect-ratio: 1; border-radius: 22px; background: var(--panel); border: 1px solid var(--line);
    box-shadow: var(--shadow); overflow: hidden;
  }
  .box :global(.scene-canvas) { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity .5s; }
  .box:global(.scene-on) :global(.scene-canvas) { opacity: 1; }
  .cap { display: flex; justify-content: space-between; gap: 12px; color: var(--muted); padding: 0 4px; }
  #xp-org { color: var(--ink); }
  #xp-when { white-space: nowrap; }

  /* after the pinned stretch */
  .after { padding: 24px var(--gutter) 96px; }
  .inner-after { width: min(1040px, 100%); margin: 0 auto; }
  .earlier { color: var(--muted); font-weight: 400; margin: 0 0 10px; }
  .minor { list-style: none; padding: 0; display: grid; gap: 10px; max-width: 760px; }
  .minor li { display: grid; grid-template-columns: 170px 1fr; gap: 12px; color: var(--muted); font-size: 14px; }
  .minor .when { white-space: nowrap; padding-top: 1px; }
  .minor li > span:last-child { color: var(--ink); }
  .minor .org { margin-left: 8px; color: var(--muted); }
  .minor .what { display: block; color: var(--muted); }
  .minor a { text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
  .end { margin-top: 40px; display: flex; gap: 24px; }
  .end a { color: var(--muted); }
  .end a:hover { color: var(--ink); }

  @media (max-width: 820px) {
    .exp { height: auto; }
    .pin { position: static; height: auto; padding: 56px var(--gutter) 8px; }
    .inner { grid-template-columns: 1fr; }
    .viewer { display: none; }
    .minor li { grid-template-columns: 1fr; gap: 0; }
  }
</style>
