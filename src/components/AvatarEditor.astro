---
// "Customize your character": the avatar editor. A head button in the top
// bar opens a full-screen editor over a dimmed page: a big preview on the
// left, a catalog of parts on the right (each tile shows the part on *your*
// head), and sliders for height and build. Saved in this browser only.
---
<button class="who" id="who" aria-haspopup="dialog" aria-controls="avatar-ed" title="Customize your character" data-blip="760">
  <span class="sr-only">Customize your character</span>
  <span class="face" id="who-face"></span>
</button>
<div class="nudge mono" id="who-nudge" hidden>customize your character ↑</div>

<div class="scrim" id="avatar-ed" role="dialog" aria-modal="true" aria-label="Customize your character" hidden>
  <div class="card">
    <div class="left">
      <div class="preview" id="ed-preview"></div>
      <div class="sliders">
        <label class="mono">height <input type="range" min="0" max="4" step="1" id="ed-height" /></label>
        <label class="mono">build <input type="range" min="0" max="4" step="1" id="ed-build" /></label>
      </div>
      <div class="actions mono">
        <button id="ed-random" data-blip="820">shuffle</button>
        <button id="ed-reset" data-blip="700">reset</button>
        <button id="ed-done" class="done" data-blip="980">done</button>
      </div>
      <p class="note">saved only in this browser</p>
    </div>
    <div class="right">
      <div class="tabs mono" id="ed-tabs" role="tablist"></div>
      <div class="grid" id="ed-grid"></div>
    </div>
    <button class="close" id="ed-x" aria-label="Close">×</button>
  </div>
</div>

<script>
  import { OPTIONS, DEFAULT, load, save, clear, svg, type Avatar, type Part } from '../scripts/avatar';
  import { blip } from '../scripts/sound';

  // tabs → which parts they show; color parts render as swatches, shape parts as head tiles
  const TABS: { name: string; parts: Part[] }[] = [
    { name: 'hair', parts: ['hair', 'hairColor'] },
    { name: 'face', parts: ['eyes', 'brows', 'mouth', 'glasses'] },
    { name: 'head', parts: ['head', 'skin'] },
    { name: 'body', parts: ['body', 'shirt'] },
  ];
  const COLOR: Part[] = ['skin', 'hairColor', 'shirt'];
  const LABEL: Partial<Record<Part, string>> = { hairColor: 'hair color', head: 'head shape', body: 'body' };

  const $ = (id: string) => document.getElementById(id)!;
  const btn = $('who'), ed = $('avatar-ed'), grid = $('ed-grid'), tabs = $('ed-tabs');
  const height = $('ed-height') as HTMLInputElement, build = $('ed-build') as HTMLInputElement;
  let cur: Avatar = load() ?? { ...DEFAULT };
  let tab = 0;

  function renderGrid() {
    grid.innerHTML = TABS[tab].parts.map((p) => `
      <section><h4 class="mono">${LABEL[p] ?? p}</h4><div class="${COLOR.includes(p) ? 'swatches' : 'tiles'}">${
        OPTIONS[p].map((o, i) => COLOR.includes(p)
          ? `<button data-p="${p}" data-v="${i}" class="sw" style="--sw:${o}" aria-label="${LABEL[p] ?? p} ${i + 1}"></button>`
          : `<button data-p="${p}" data-v="${i}" class="tile" title="${o}">${p === 'body' ? svg({ ...cur, [p]: i }) : svg({ ...cur, [p]: i }, true)}<span class="mono">${o}</span></button>`).join('')
      }</div></section>`).join('');
    mark();
  }
  function mark() {
    grid.querySelectorAll<HTMLButtonElement>('[data-p]').forEach((b) =>
      b.setAttribute('aria-pressed', String(cur[b.dataset.p as Part] === Number(b.dataset.v))));
  }
  function paint() {
    $('ed-preview').innerHTML = svg(cur);
    $('who-face').innerHTML = svg(cur, true);
    height.value = String(cur.height); build.value = String(cur.build);
  }
  const set = (p: Part, v: number) => { cur = { ...cur, [p]: v }; save(cur); paint(); };

  tabs.innerHTML = TABS.map((t, i) => `<button role="tab" data-t="${i}">${t.name}</button>`).join('');
  const setTab = (i: number) => { tab = i; tabs.querySelectorAll('button').forEach((b, j) => b.setAttribute('aria-selected', String(j === i))); renderGrid(); };
  tabs.addEventListener('click', (e) => { const b = (e.target as Element).closest<HTMLButtonElement>('[data-t]'); if (b) { setTab(Number(b.dataset.t)); blip(820, 0.04, 0.02); } });
  grid.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-p]');
    if (!b) return;
    set(b.dataset.p as Part, Number(b.dataset.v));
    renderGrid();                                              // tiles show the new choice on your head
    blip(700 + Number(b.dataset.v) * 60, 0.04, 0.02);
  });
  height.addEventListener('input', () => set('height', Number(height.value)));
  build.addEventListener('input', () => set('build', Number(build.value)));
  $('ed-random').addEventListener('click', () => {
    cur = Object.fromEntries(Object.entries(OPTIONS).map(([p, o]) => [p, Math.floor(Math.random() * o.length)])) as Avatar;
    save(cur); paint(); renderGrid();
  });
  $('ed-reset').addEventListener('click', () => { cur = { ...DEFAULT }; clear(); paint(); renderGrid(); });

  const open = (on: boolean) => {
    ed.hidden = !on; btn.setAttribute('aria-expanded', String(on));
    document.documentElement.classList.toggle('editing', on);
    if (on) { nudge.hidden = true; setTab(tab); }
  };
  btn.addEventListener('click', () => open(ed.hidden));
  $('ed-done').addEventListener('click', () => open(false));
  $('ed-x').addEventListener('click', () => open(false));
  ed.addEventListener('pointerdown', (e) => { if (e.target === ed) open(false); });           // click the dimmed backdrop
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !ed.hidden) { open(false); e.stopImmediatePropagation(); } }, { capture: true });
  paint();

  // The nudge: while someone still has the default avatar, a few seconds in
  // the head button wiggles (with a soft blip) and a quiet bubble appears.
  // At most three visits, then it stops asking.
  const nudge = $('who-nudge');
  let shown = 0; try { shown = Number(localStorage.getItem('avatar-nudges') || 0); } catch {}
  if (!load() && shown < 3 && !sessionStorage.getItem('avatar-nudged')) {
    setTimeout(() => {
      if (!ed.hidden) return;
      try { localStorage.setItem('avatar-nudges', String(shown + 1)); sessionStorage.setItem('avatar-nudged', '1'); } catch {}
      btn.classList.add('wiggle'); nudge.hidden = false; blip(880, 0.05, 0.02); setTimeout(() => blip(1180, 0.06, 0.02), 90);
      setTimeout(() => btn.classList.remove('wiggle'), 1200);
      setTimeout(() => (nudge.hidden = true), 7000);
    }, 3000);
  }
</script>

<style>
  .who { background: none; border: 0; padding: 2px; cursor: pointer; display: flex; border-radius: 50%; }
  .face { width: 24px; height: 24px; display: block; border-radius: 50%; overflow: hidden; background: var(--panel); border: 1px solid var(--line); transition: transform .16s cubic-bezier(.3,1.6,.5,1); }
  .face :global(svg) { width: 100%; height: 100%; }
  .who:hover .face { transform: scale(1.12); }
  .who:global(.wiggle) .face { animation: wiggle 1.1s ease-in-out; }
  @keyframes wiggle { 10%, 30%, 50%, 70% { transform: rotate(-12deg) scale(1.15); } 20%, 40%, 60%, 80% { transform: rotate(12deg) scale(1.15); } }

  .nudge {
    position: fixed; top: 52px; right: calc(var(--gutter) + 18px); z-index: 45; pointer-events: none;
    background: var(--ink); color: var(--panel); padding: 6px 11px; border-radius: 99px; font-size: 11px;
    animation: nudge-in .35s cubic-bezier(.3,1.5,.5,1), bob 1.8s ease-in-out .35s infinite;
  }
  .nudge[hidden] { display: none; }
  @keyframes nudge-in { from { transform: translateY(-6px) scale(.9); opacity: 0; } }
  @keyframes bob { 50% { transform: translateY(-3px); } }

  /* full-screen editor over a dimmed page */
  .scrim { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; padding: 20px; background: rgba(20, 18, 28, .42); backdrop-filter: blur(3px); animation: fade .2s ease; }
  .scrim[hidden] { display: none; }
  @keyframes fade { from { opacity: 0; } }
  .card {
    position: relative; width: min(860px, 100%); max-height: min(640px, 100%); overflow: auto;
    display: grid; grid-template-columns: 300px 1fr; gap: 24px; padding: 24px;
    background: var(--panel); color: var(--ink); border-radius: 22px; border: 1px solid var(--line);
    box-shadow: 0 30px 80px -30px rgba(0,0,0,.5); font-family: var(--sans);
    animation: pop .28s cubic-bezier(.3,1.4,.5,1);
  }
  @keyframes pop { from { transform: translateY(10px) scale(.97); opacity: 0; } }
  .left { display: grid; gap: 14px; align-content: start; }
  .preview { height: 300px; display: grid; place-items: center; background: var(--bg); border-radius: 16px; border: 1px solid var(--line); }
  .preview :global(svg) { height: 270px; width: auto; }
  .sliders { display: grid; gap: 8px; }
  .sliders label { display: grid; grid-template-columns: 56px 1fr; align-items: center; gap: 10px; color: var(--muted); font-size: 12px; }
  .sliders input { accent-color: var(--sel); }
  .actions { display: flex; gap: 8px; }
  .actions button { flex: 1; border: 1px solid var(--line); background: var(--bg); color: var(--muted); border-radius: 99px; padding: 7px 10px; cursor: pointer; font: inherit; font-size: 12px; }
  .actions button:hover { color: var(--ink); }
  .actions .done { background: var(--ink); color: var(--panel); border-color: var(--ink); }
  .note { color: var(--muted); font-size: 11px; font-weight: 300; opacity: .7; text-align: center; }

  .right { min-width: 0; display: grid; gap: 14px; align-content: start; }
  .tabs { display: flex; gap: 6px; padding-right: 36px; }
  .tabs :global(button) { border: 1px solid var(--line); background: var(--bg); color: var(--muted); border-radius: 99px; padding: 5px 14px; cursor: pointer; font: inherit; font-size: 12px; }
  .tabs :global(button[aria-selected="true"]) { background: var(--ink); color: var(--panel); border-color: var(--ink); }
  .grid { display: grid; gap: 16px; }
  .grid :global(h4) { color: var(--muted); font-weight: 400; font-size: 11px; margin-bottom: 8px; text-transform: lowercase; }
  .grid :global(.tiles) { display: grid; grid-template-columns: repeat(auto-fill, minmax(78px, 1fr)); gap: 8px; }
  .grid :global(.tile) {
    display: grid; justify-items: center; gap: 2px; padding: 6px 4px 5px; border-radius: 14px; cursor: pointer;
    border: 1px solid var(--line); background: var(--bg); color: var(--muted);
    transition: transform .14s cubic-bezier(.3,1.6,.5,1), border-color .14s;
  }
  .grid :global(.tile svg) { width: 58px; height: 58px; }
  .grid :global(.tile span) { font-size: 10px; }
  .grid :global(.tile:hover) { transform: translateY(-2px); }
  .grid :global(.tile[aria-pressed="true"]) { border-color: var(--sel); box-shadow: 0 0 0 2px var(--sel) inset; color: var(--ink); background: var(--panel); }
  .grid :global(.swatches) { display: flex; flex-wrap: wrap; gap: 8px; }
  .grid :global(.sw) { width: 30px; height: 30px; border-radius: 50%; background: var(--sw); border: 2px solid var(--panel); outline: 1px solid var(--line); cursor: pointer; padding: 0; }
  .grid :global(.sw[aria-pressed="true"]) { outline: 2px solid var(--sel); }
  .close { position: absolute; top: 16px; right: 16px; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--line); background: var(--bg); color: var(--muted); font: 20px/1 var(--sans); cursor: pointer; }
  .close:hover { color: var(--ink); }

  @media (max-width: 720px) {
    .scrim { padding: 10px; align-items: end; }
    .card { grid-template-columns: 1fr; max-height: 92svh; padding: 16px; gap: 14px; border-radius: 20px 20px 16px 16px; }
    .preview { height: 190px; }
    .preview :global(svg) { height: 170px; }
    .grid :global(.tiles) { grid-template-columns: repeat(auto-fill, minmax(68px, 1fr)); }
  }
</style>
