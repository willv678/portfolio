---
// "Next app" at the bottom of a project page: a small tile + the next title.
interface Props { href: string; title: string; color: string; icon: string }
const { href, title, color, icon } = Astro.props;
---
<nav class="next" aria-label="More">
  <a class="home mono" href="/" data-blip="700"><kbd>esc</kbd> home</a>
  <a class="nx" href={href} data-blip="980">
    <span class="mono lbl">next</span>
    <span class="t">{title}</span>
    <span class="tile" style={`color:${color}`} set:html={icon} />
  </a>
</nav>
<style>
  .next { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 72px; padding-top: 24px; border-top: 1px solid var(--line); }
  .home { color: var(--muted); text-decoration: none; display: flex; gap: 8px; align-items: center; }
  .home:hover { color: var(--ink); }
  kbd { font: inherit; border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 5px; padding: 0 5px; background: var(--panel); }
  .nx { display: flex; align-items: center; gap: 14px; text-decoration: none; }
  .lbl { color: var(--muted); }
  .t { font-family: var(--serif); font-size: 20px; }
  .tile {
    width: 56px; height: 56px; border-radius: 15px; background: var(--panel); border: 1px solid var(--line);
    box-shadow: var(--shadow); display: grid; place-items: center; padding: 13px;
    transition: transform .18s cubic-bezier(.3,1.6,.5,1);
  }
  .tile :global(svg) { width: 100%; height: auto; }
  .nx:hover .tile { transform: translateY(-3px) scale(1.05); }
</style>
