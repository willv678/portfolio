---
import '../styles/fonts.css';
import '../styles/global.css';
import { posts } from '../lib';
import AvatarEditor from '../components/AvatarEditor.astro';

interface Props {
  title?: string;
  description?: string;
  accent?: string;
  home?: boolean;   // the home page has no top-left name (it's in the panel)
  prev?: string;    // ← / → targets (projects and posts)
  next?: string;
}
const { title, description, accent, home = false, prev, next } = Astro.props;
const fullTitle = title ? `${title} · Will Varner` : 'Will Varner';
const desc = description ?? 'Will Varner finds where things break: AI at work (self-driving research at UGA, agents at Roblox, Abridge in 2027), games for fun.';
const hasWriting = (await posts()).length > 0;
const path = Astro.url.pathname;
const here = (p: string) => (path.startsWith(p) ? 'page' : undefined);
// Speculation rules (Chrome/Edge): the pages you're most likely to go to next
// are rendered ahead of time in the background, so Esc and ← / → are instant.
// From a project: home and its neighbors, right away. From home: a project as
// soon as you hover or focus its tile.
const rules = home
  ? { prerender: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/*.pdf' } }] }, eagerness: 'moderate' }] }
  : { prerender: [{ urls: ['/', prev, next].filter(Boolean), eagerness: 'immediate' }] };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content={new URL('/me.jpg', Astro.site)} />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <link rel="icon" href="/favicon.ico" />
  <!-- fonts are served from this site (src/styles/fonts.css); fetch the main three right away -->
  <link rel="preload" href="/fonts/ibm-plex-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/fraunces-500-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/ibm-plex-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin />
  {prev && <link rel="prev" href={prev} />}
  {next && <link rel="next" href={next} />}
  <slot name="head" />
  <script is:inline define:vars={{ rules }}>
    // Only on mouse-and-keyboard devices: on phones nobody presses Esc or ←/→,
    // so preparing pages ahead would just spend their data. (Rules in Base frontmatter.)
    if (HTMLScriptElement.supports?.('speculationrules') && matchMedia('(hover: hover)').matches) {
      const s = document.createElement('script'); s.type = 'speculationrules'; s.textContent = JSON.stringify(rules); document.head.append(s);
    }
  </script>
  <script is:inline>
    // ?fresh — forget everything this site saved in this browser (avatar, the
    // "make your own character" nudge, mute), then reload as a first-time visitor.
    if (new URLSearchParams(location.search).has('fresh')) {
      try { ['avatar', 'avatar-nudges', 'avatar-nudged', 'muted'].forEach((k) => localStorage.removeItem(k)); sessionStorage.clear(); } catch (e) {}
      location.replace(location.pathname + location.hash);
    }
  </script>
  <script is:inline>
    // ← / → page turns slide in the direction you pressed. The direction is
    // stashed before navigating and read here on both sides of the transition.
    // (Must be inline in <head>, so it's registered before the first frame.)
    addEventListener('pageswap', (e) => { const d = sessionStorage.getItem('nav-dir'); if (d && e.viewTransition) e.viewTransition.types.add(d); });
    addEventListener('pagereveal', (e) => { const d = sessionStorage.getItem('nav-dir'); sessionStorage.removeItem('nav-dir'); if (d && e.viewTransition) e.viewTransition.types.add(d); });
  </script>
  <script is:inline define:vars={{ home }}>
    // Esc is the B button: back to the home screen. ← / → turn the page to the
    // previous / next project or post (from <link rel=prev/next>). Inline in
    // <head> so the keys work from the first moment, even mid-load.
    if (!home) addEventListener('keydown', (e) => {
      if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.altKey || e.shiftKey || e.repeat) return;
      if (e.target.closest && e.target.closest('input, textarea, select, pre, iframe, [contenteditable]')) return;
      let href = '/', dir = '';
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        dir = e.key === 'ArrowRight' ? 'next' : 'prev';
        const link = document.querySelector('link[rel=' + dir + ']');
        if (!link) return;
        href = link.href;
      } else if (e.key !== 'Escape') return;
      e.preventDefault();
      try { dir ? sessionStorage.setItem('nav-dir', dir) : sessionStorage.removeItem('nav-dir'); } catch (_) {}
      location.href = href;
    });
  </script>
</head>
<body style={accent ? `--accent:${accent}` : undefined} data-home={home ? '' : undefined}>
  <header class="top mono">
    {home ? <span /> : <a class="back" href="/" data-blip="700" title="Home (esc)"><span class="arr" aria-hidden="true">←</span>Will Varner</a>}
    <nav>
      <a href="/#experience" data-blip="820">experience</a>
      {hasWriting
        ? <a href="/writing/" aria-current={here('/writing')} data-blip="860">writing</a>
        : <span class="soon" tabindex="0" aria-disabled="true">writing<span class="tip" role="tooltip">coming soon</span></span>}
      <a href="/CSResume.pdf" target="_blank" rel="noopener" data-blip="900">resume ↗</a>
      <AvatarEditor />
      <button id="snd" class="snd" aria-pressed="true" title="Sound on">
        <span class="sr-only">Toggle sound</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 6h3l4-3v10L5 10H2z" /><path class="wave" d="M11.5 5.5a3.5 3.5 0 0 1 0 5" /></svg>
      </button>
    </nav>
  </header>

  <slot />

  <script>
    import { initSoundButton, initHoverBlips } from '../scripts/sound';
    initSoundButton();
    initHoverBlips();
  </script>
</body>
</html>

<style>
  .top {
    display: flex; justify-content: space-between; align-items: center;
    padding: 18px var(--gutter); color: var(--muted);
  }
  .top a { text-decoration: none; }
  .top a:hover, .top a[aria-current] { color: var(--ink); }
  .back { font-family: var(--sans); font-size: 14px; font-weight: 500; color: var(--ink); letter-spacing: 0; display: inline-flex; gap: 8px; align-items: center; }
  .back .arr { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 99px; border: 1px solid var(--line); background: var(--panel); box-shadow: var(--shadow); transition: transform .16s cubic-bezier(.3,1.6,.5,1); }
  .back:hover .arr { transform: translateX(-3px); }
  /* The top bar holds still while pages slide underneath it. */
  .top { view-transition-name: topbar; position: relative; z-index: 40; }   /* above the page, so the avatar editor isn't covered */
  nav { display: flex; gap: 20px; align-items: center; }
  /* "writing" before the first post exists: greyed, with a small "coming soon" on hover */
  .soon { position: relative; opacity: .45; cursor: default; }
  .soon .tip {
    position: absolute; top: calc(100% + 8px); left: 50%; translate: -50% 0; white-space: nowrap; pointer-events: none;
    background: var(--ink); color: var(--panel); font-size: 10.5px; padding: 3px 8px; border-radius: 99px;
    opacity: 0; transform: translateY(-3px); transition: opacity .15s, transform .15s;
  }
  .soon:hover, .soon:focus-visible { opacity: .7; }
  .soon:hover .tip, .soon:focus-visible .tip { opacity: 1; transform: none; }
  .snd { background: none; border: 0; color: inherit; cursor: pointer; padding: 4px; display: flex; }
  .snd:hover { color: var(--ink); }
  @media (max-width: 720px) { nav { gap: 12px; } .top { padding-top: 14px; padding-bottom: 14px; } }
</style>
